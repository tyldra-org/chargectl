<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Widget extensions must be sandboxed. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Ask Chargectl's helper for its status and run widget buttons. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array><string>com.tyldra.chargectl.daemon</string></array>
    <!-- Power readings (charger, Mac) come from the SMC. -->
    <key>com.apple.security.temporary-exception.iokit-user-client-class</key>
    <array><string>AppleSMCClient</string></array>
</dict></plist>
